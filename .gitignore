# Binaries
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
/mfi
/mfi-gui

# Test & coverage output
*.test
*.out
coverage.*

# Go workspace files
go.work
go.work.sum

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Wails: compiled app output (keep build/darwin config + appicon.png)
**/build/bin/
# Generated Wails JS/TS bindings — the runtime injects window.go regardless,
# and the vanilla frontend doesn't import them.
cmd/mfi-gui/frontend/dist/wailsjs/
# Node deps, if a build-based frontend is ever added
node_modules/

# Local-only docs (agent guidance + founding spec) — kept out of the repo
CLAUDE.md
intial_claude_prompt.md

# --- Project-sensitive: NEVER commit extracted device data, secrets, or reports ---
/captures/
/extractions/
/reports/
*.mfi-report.json
known-secrets*.txt

# Release engineering: build output, and belt-and-braces guards so the
# release-signing PRIVATE key can never be committed even if someone points
# scripts/release-keygen.sh --out-dir into the checkout. The committed trust
# anchor .mobfi-pubkey.b64 (public half only) is NOT ignored on purpose.
/dist/
/release-keys/
mobfi-release*.private
